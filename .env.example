# ── Wallet & Authentication ──────────────────────────────────────────
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE
FUNDER_ADDRESS=
SIGNATURE_TYPE=0
CHAIN_ID=137

# ── CLOB & Gamma API ────────────────────────────────────────────────
CLOB_HOST=https://clob.polymarket.com
GAMMA_API_URL=https://gamma-api.polymarket.com

# ── Capital & Risk ──────────────────────────────────────────────────
TOTAL_CAPITAL=10000
MAX_CAPITAL_PER_MARKET=500
MIN_CAPITAL_PER_MARKET=200
GLOBAL_MAX_EXPOSURE_PCT=0.30
GLOBAL_MAX_GROSS_EXPOSURE_PCT=0.80
DAILY_DRAWDOWN_LIMIT_PCT=0.05

# ── Strategy ────────────────────────────────────────────────────────
MODE=safe
DRY_RUN=true
# Optional paper starting cash when DRY_RUN=true (defaults to TOTAL_CAPITAL).
# PAPER_CASH=10000
TIGHTNESS_FACTOR_SAFE=0.48
TIGHTNESS_FACTOR_AGGRESSIVE=0.35
SIZE_MULTIPLIER=2.0
REBALANCE_INTERVAL_SECONDS=45
ORDER_UPDATE_THRESHOLD_TICKS=1
POST_BEFORE_CANCEL=false
QUOTE_OFFSET_TICKS=1

# ── WebSocket / Event-Driven Quoting ────────────────────────────────
WS_ENABLED=true
HOT_REQUOTE_DEBOUNCE_MS=1000

# ── Toxicity / Adverse-selection (P2b) ──────────────────────────────
# Replaces the legacy ADVERSE_FILL_RATE_THRESHOLD blunt instrument.
# VPIN: rolling buy/sell imbalance over the last N bot fills drives a
# spread multiplier; breaching the pause threshold cancels quotes for
# TOXICITY_PAUSE_SECONDS (auto-resume on expiry, Discord alert on entry).
# Fill-vs-mid scoring adds a continuous adverse-drift signal evaluated
# at +5s/+30s/+5min after each fill, weighted 0.2/0.3/0.5.
# The two signals combine via max() then multiply QUOTE_OFFSET_TICKS in
# Quoter._compute_offset (final offset still capped by max_spread*0.499).
VPIN_WINDOW_FILLS=50
VPIN_THRESHOLD=0.7
VPIN_PAUSE_THRESHOLD=0.85
TOXICITY_FILL_WINDOW_SECONDS=300
TOXICITY_PAUSE_SECONDS=180
TOXICITY_SPREAD_MULTIPLIER_MAX=2.5

# ── Market Selection ────────────────────────────────────────────────
MAX_MARKETS=20
MIN_MARKETS=3
# Cold cycle touch cap — keep ≥ MAX_MARKETS so all selected books are quoted.
MAX_MARKETS_PER_CYCLE=60
MIN_END_DATE_DAYS=120
MIN_REWARDS_MAX_SPREAD=0.03
MAX_24H_VOLUME=800000
MIN_24H_VOLUME=500
MIN_REWARD_RATE_DAILY=5.0
MIDPOINT_MIN=0.15
MIDPOINT_MAX=0.85
# Continuous midpoint guard: pause market if live_mid drifts outside band
# for N consecutive cold cycles. Auto-resume on first in-band reading.
MIDPOINT_GUARD_MIN=0.18
MIDPOINT_GUARD_MAX=0.82
MIDPOINT_GUARD_CYCLES=3

# ── Volatility & Spike Detection ────────────────────────────────────
# Realised vol stdev over VOL_WINDOW_SECONDS scales QUOTE_OFFSET_TICKS
# by a multiplier in [MIN, MAX] — calm book → tighter, volatile → wider.
VOL_WINDOW_SECONDS=900
VOL_SPREAD_MULTIPLIER_MIN=0.7
VOL_SPREAD_MULTIPLIER_MAX=3.0
# Spike detector: if mid range (max-min) over SPIKE_DETECTION_WINDOW_SECONDS
# reaches SPIKE_TICKS_THRESHOLD ticks → cancel quotes + pause for
# SPIKE_PAUSE_SECONDS. Resume is progressive via the vol multiplier.
SPIKE_TICKS_THRESHOLD=5
SPIKE_DETECTION_WINDOW_SECONDS=30
SPIKE_PAUSE_SECONDS=120

# ── Inventory Seeding (bootstrap tokens for two-sided quoting) ──────
SEED_ENABLED=true
SEED_MAX_USD_PER_SIDE=150
SEED_AGGRESSIVE_TICKS=3
# Inventory budget; remainder of TOTAL_CAPITAL stays as BID cash reserve.
SEED_BUDGET_PCT=0.65

# ── Resolution Guard (P2d) ─────────────────────────────────────────
# Pre-resolution risk gate (core/resolution_guard.py). Two checks per market
# evaluated every cold cycle, BEFORE the exposure gate:
#   - max-loss : worst-case USD loss = abs(yes_size - no_size)
#                (unmatched tokens × $1; matched YES+NO redeem at $1).
#   - 24h move : abs(mid_now - mid_24h_ago) / mid_24h_ago * 100.
#                Requires ≥ 20 min of recorded history; ±30 min tolerance
#                when matching the (now − 24h) anchor in the rolling deque.
# Plus a hard-coded safety net: mid < 0.05 or > 0.95 always forces delist
# (asymmetric payoff + thin book this close to resolution).
RESOLUTION_MAX_LOSS_USD=25.0
RESOLUTION_MAX_MOVE_24H_PCT=15.0

# ── Skew Management ────────────────────────────────────────────────
SKEW_ALERT_THRESHOLD=0.25
SKEW_ACTION_THRESHOLD=0.30
SKEW_PAUSE_THRESHOLD=0.45
SKEW_HARD_PAUSE_THRESHOLD=0.70
SKEW_PAUSE_DURATION_SECONDS=600
SKEW_ALERT_COOLDOWN_SECONDS=900
SKEW_RECOVERY_ASK_SIZE_PCT=0.50

# ── Scoring Monitor ─────────────────────────────────────────────────
SCORING_CHECK_INTERVAL_SECONDS=300
SCORING_ALERT_THRESHOLD=0.70
SCORING_REMEDIATION_THRESHOLD=3

# ── Rewards Estimation ──────────────────────────────────────────────
# Fraction of the daily pool we estimate as our share.
# Override with a q_score_ratio at runtime when Q-score tracking is wired up.
LP_ESTIMATED_SHARE=0.10

# ── Dynamic Reallocation ────────────────────────────────────────────
DYNAMIC_REALLOC_ENABLED=true
DYNAMIC_REALLOC_INTERVAL_SECONDS=300
DYNAMIC_REALLOC_MAX_SHIFT_PCT=0.20

# ── Circuit Breaker ─────────────────────────────────────────────────
CIRCUIT_BREAKER_MAX_FAILURES=3
CIRCUIT_BREAKER_COOLDOWN_SECONDS=300

# ── API Rate Limiting ──────────────────────────────────────────────
API_RATE_LIMIT_RPS=1.5
API_RATE_LIMIT_BURST=20

# ── Local tape (append-only JSONL + optional localhost HTTP) ────
TAPE_HTTP_ENABLED=true
TAPE_HTTP_PORT=8765
FILL_POLL_INTERVAL_SECONDS=3

# ── Discord ─────────────────────────────────────────────────────────
# One webhook — content / username auto-tagged DRY_RUN vs LIVE from DRY_RUN=
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_HERE
# Comma-separated kinds that may fire (empty = none). Unknown tokens ignored.
# Kinds: startup, orders, cycle, fills, skew, errors, daily, alerts
# Boot default only — UI toggles persist to data/discord_channels.json and win on restart.
DISCORD_CHANNELS=startup,orders,cycle,fills,skew,errors,daily,alerts

# ── Logging ─────────────────────────────────────────────────────────
LOG_LEVEL=INFO
