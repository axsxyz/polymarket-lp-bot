# ── Wallet & Authentication ──────────────────────────────────────────
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE
FUNDER_ADDRESS=
SIGNATURE_TYPE=0
CHAIN_ID=137

# ── CLOB & Gamma API ────────────────────────────────────────────────
CLOB_HOST=https://clob.polymarket.com
GAMMA_API_URL=https://gamma-api.polymarket.com

# ── Capital & Risk ──────────────────────────────────────────────────
TOTAL_CAPITAL=10000
MAX_CAPITAL_PER_MARKET=500
MIN_CAPITAL_PER_MARKET=200
GLOBAL_MAX_EXPOSURE_PCT=0.30
GLOBAL_MAX_GROSS_EXPOSURE_PCT=0.80
DAILY_DRAWDOWN_LIMIT_PCT=0.05

# ── Strategy ────────────────────────────────────────────────────────
MODE=safe
DRY_RUN=true
TIGHTNESS_FACTOR_SAFE=0.48
TIGHTNESS_FACTOR_AGGRESSIVE=0.35
SIZE_MULTIPLIER=2.0
ALLOW_NAKED_ASKS=true
REBALANCE_INTERVAL_SECONDS=45
ORDER_UPDATE_THRESHOLD_TICKS=1
POST_BEFORE_CANCEL=false
QUOTE_OFFSET_TICKS=1

# ── WebSocket / Event-Driven Quoting ────────────────────────────────
WS_ENABLED=true
HOT_REQUOTE_DEBOUNCE_MS=1000
ADVERSE_FILL_RATE_THRESHOLD=3

# ── Market Selection ────────────────────────────────────────────────
MAX_MARKETS=20
MIN_MARKETS=30
MAX_MARKETS_PER_CYCLE=20
MIN_END_DATE_DAYS=120
MIN_REWARDS_MAX_SPREAD=0.03
MAX_24H_VOLUME=800000
MIN_24H_VOLUME=500
MIN_REWARD_RATE_DAILY=5.0
MIDPOINT_MIN=0.15
MIDPOINT_MAX=0.85
# Continuous midpoint guard: pause market if live_mid drifts outside band
# for N consecutive cold cycles. Auto-resume on first in-band reading.
MIDPOINT_GUARD_MIN=0.18
MIDPOINT_GUARD_MAX=0.82
MIDPOINT_GUARD_CYCLES=3

# ── Volatility & Spike Detection ────────────────────────────────────
# Realised vol stdev over VOL_WINDOW_SECONDS scales QUOTE_OFFSET_TICKS
# by a multiplier in [MIN, MAX] — calm book → tighter, volatile → wider.
VOL_WINDOW_SECONDS=900
VOL_SPREAD_MULTIPLIER_MIN=0.7
VOL_SPREAD_MULTIPLIER_MAX=3.0
# Spike detector: if mid range (max-min) over SPIKE_DETECTION_WINDOW_SECONDS
# reaches SPIKE_TICKS_THRESHOLD ticks → cancel quotes + pause for
# SPIKE_PAUSE_SECONDS. Resume is progressive via the vol multiplier.
SPIKE_TICKS_THRESHOLD=5
SPIKE_DETECTION_WINDOW_SECONDS=30
SPIKE_PAUSE_SECONDS=120

# ── Inventory Seeding (bootstrap tokens for two-sided quoting) ──────
SEED_ENABLED=true
SEED_MAX_USD_PER_SIDE=150
SEED_AGGRESSIVE_TICKS=3
SEED_BUDGET_PCT=0.30

# ── Skew Management ────────────────────────────────────────────────
SKEW_ALERT_THRESHOLD=0.25
SKEW_ACTION_THRESHOLD=0.30
SKEW_PAUSE_THRESHOLD=0.45
SKEW_HARD_PAUSE_THRESHOLD=0.70
SKEW_PAUSE_DURATION_SECONDS=600
SKEW_ALERT_COOLDOWN_SECONDS=900
SKEW_RECOVERY_ASK_SIZE_PCT=0.50

# ── Scoring Monitor ─────────────────────────────────────────────────
SCORING_CHECK_INTERVAL_SECONDS=300
SCORING_ALERT_THRESHOLD=0.70
SCORING_REMEDIATION_THRESHOLD=3

# ── Dynamic Reallocation ────────────────────────────────────────────
DYNAMIC_REALLOC_ENABLED=true
DYNAMIC_REALLOC_INTERVAL_SECONDS=300
DYNAMIC_REALLOC_MAX_SHIFT_PCT=0.20

# ── Circuit Breaker ─────────────────────────────────────────────────
CIRCUIT_BREAKER_MAX_FAILURES=3
CIRCUIT_BREAKER_COOLDOWN_SECONDS=300

# ── API Rate Limiting ──────────────────────────────────────────────
API_RATE_LIMIT_RPS=1.5
API_RATE_LIMIT_BURST=20

# ── Discord ─────────────────────────────────────────────────────────
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_HERE

# ── Logging ─────────────────────────────────────────────────────────
LOG_LEVEL=INFO
